Step 2: Generate SSH Keys for Agent Authentication
# Generate SSH key for jenkins user
sudo -u jenkins ssh-keygen -t rsa -b 4096 -f /var/lib/jenkins/.ssh/id_rsa -N ""

# Generate SSH keys for agent users
sudo -u jenkins-agent1 ssh-keygen -t rsa -b 4096 -f /home/jenkins-agent1/.ssh/id_rsa -N ""
sudo -u jenkins-agent2 ssh-keygen -t rsa -b 4096 -f /home/jenkins-agent2/.ssh/id_rsa -N ""

# Set up authorized_keys for SSH access
sudo -u jenkins-agent1 cp /home/jenkins-agent1/.ssh/id_rsa.pub /home/jenkins-agent1/.ssh/authorized_keys
sudo -u jenkins-agent2 cp /home/jenkins-agent2/.ssh/id_rsa.pub /home/jenkins-agent2/.ssh/authorized_keys

# Copy jenkins master key to agent authorized_keys
sudo -u jenkins-agent1 cat /var/lib/jenkins/.ssh/id_rsa.pub >> /home/jenkins-agent1/.ssh/authorized_keys
sudo -u jenkins-agent2 cat /var/lib/jenkins/.ssh/id_rsa.pub >> /home/jenkins-agent2/.ssh/authorized_keys

# Set proper permissions
sudo chmod 700 /home/jenkins-agent1/.ssh
sudo chmod 600 /home/jenkins-agent1/.ssh/*
sudo chmod 700 /home/jenkins-agent2/.ssh
sudo chmod 600 /home/jenkins-agent2/.ssh/*
