Step 3: Analyze Build Performance
Create a performance analysis script:

cat > /tmp/analyze-performance.sh << 'EOF'
#!/bin/bash

echo "Jenkins Build Performance Analysis"
echo "================================="

# Get build history for analysis
analyze_job_performance() {
    local job_name=$1
    echo "Analyzing performance for job: $job_name"
    
    curl -s "http://admin:admin@localhost:8080/job/$job_name/api/json?tree=builds[number,duration,result,builtOn]" | python3 -c "
import sys, json
data = json.load(sys.stdin)
builds = data.get('builds', [])[:10]  # Last 10 builds

if builds:
    print(f'Recent builds for $job_name:')
    total_duration = 0
    successful_builds = 0
    
    for build in builds:
        duration_sec = build['duration'] / 1000 if build['duration'] else 0
        duration_min = duration_sec / 60
        result = build['result'] or 'RUNNING'
        node = build.get('builtOn', 'unknown')
        
        print(f'  Build #{build[\"number\"]}: {result} - {duration_min:.1f}min on {node}')
        
        if build['result'] == 'SUCCESS':
            total_duration += duration_sec
            successful_builds += 1
    
    if successful_builds > 0:
        avg_duration = (total_duration / successful_builds) / 60
        print(f'  Average successful build time: {avg_duration:.1f} minutes')
    print()
else:
    print(f'No build history found for $job_name')
    print()
"
}

# Analyze each job
analyze_job_performance "ssh-agent-test"
analyze_job_performance "jnlp-agent-test" 
analyze_job_performance "docker-agent-test"
analyze_job_performance "parallel-build-pipeline"

# Overall system performance
echo "System Resource Usage:"
echo "====================="
echo "CPU Usage:"
top -bn1 | grep "Cpu(s)" | awk '{print $2}' | cut -d'%' -f1

echo "Memory Usage:"
free -h

echo "Disk Usage:"
df -h /

echo "Jenkins Process Info:"
