Step 3: Configure Pipeline Script
Add the following pipeline script:

pipeline {
    agent none
    
    stages {
        stage('Parallel Builds') {
            parallel {
                stage('SSH Agent Build') {
                    agent {
                        label 'ssh-agent'
                    }
                    steps {
                        echo 'Building on SSH Agent'
                        sh '''
                            echo "SSH Agent Details:"
                            echo "Hostname: $(hostname)"
                            echo "User: $(whoami)"
                            echo "Date: $(date)"
                            echo "Simulating build process..."
                            sleep 15
                            echo "SSH Agent build completed"
                        '''
                    }
                }
                
                stage('JNLP Agent Build') {
                    agent {
                        label 'jnlp-agent'
                    }
                    steps {
                        echo 'Building on JNLP Agent'
                        sh '''
                            echo "JNLP Agent Details:"
                            echo "Hostname: $(hostname)"
                            echo "User: $(whoami)"
                            echo "Date: $(date)"
                            echo "Simulating build process..."
                            sleep 15
                            echo "JNLP Agent build completed"
                        '''
                    }
                }
                
                stage('Docker Agent Build') {
                    agent {
                        label 'docker-agent'
                    }
                    steps {
                        echo 'Building on Docker Agent'
                        sh '''
                            echo "Docker Agent Details:"
                            echo "Hostname: $(hostname)"
                            echo "User: $(whoami)"
                            echo "Date: $(date)"
                            echo "Container info: $(cat /proc/version)"
                            echo "Simulating build process..."
                            sleep 15
                            echo "Docker Agent build completed"
                        '''
                    }
                }
            }
        }
        
        stage('Collect Results') {
            agent {
                label 'master'
            }
            steps {
                echo 'All parallel builds completed successfully'
                echo 'Collecting and processing results...'
                sh '''
                    echo "Build Summary:"
                    echo "=============="
                    echo "All agents executed builds in parallel"
                    echo "Total execution time reduced through parallelization"
                    echo "Build completed at: $(date)"
                '''
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline execution completed'
        }
        success {
            echo 'All builds succeeded!'
        }
        failure {
            echo 'One or more builds failed'
        }
    }
}
Click Save

Subtask 2.3: Monitor Build Execution and Performance
Step 1: Create Build Monitoring Script
# Create monitoring script
cat > /tmp/monitor-builds.sh << 'EOF'
#!/bin/bash

echo "Jenkins Build Monitoring Dashboard"
echo "================================="

# Function to get build queue
get_build_queue() {
    echo "Current Build Queue:"
    curl -s "http://admin:admin@localhost:8080/queue/api/json" | python3 -c "
import sys, json
data = json.load(sys.stdin)
if data['items']:
    for item in data['items']:
        print(f\"  - {item['task']['name']} (waiting)\")
else:
    print('  No jobs in queue')
"
}

# Function to get running builds
get_running_builds() {
    echo "Currently Running Builds:"
    curl -s "http://admin:admin@localhost:8080/computer/api/json" | python3 -c "
import sys, json
data = json.load(sys.stdin)
running_found = False
for computer in data['computer']:
    if computer['executors']:
        for executor in computer['executors']:
            if executor['currentExecutable']:
                print(f\"  - {executor['currentExecutable']['fullDisplayName']} on {computer['displayName']}\")
                running_found = True
if not running_found:
    print('  No builds currently running')
"
}

# Function to get agent status
get_agent_status() {
    echo "Agent Status:"
    curl -s "http://admin:admin@localhost:8080/computer/api/json" | python3 -c "
import sys, json
data = json.load(sys.stdin)
for computer in data['computer']:
    status = 'Online' if not computer['offline'] else 'Offline'
    executors = len([e for e in computer['executors'] if e['currentExecutable']])
    total_executors = computer['numExecutors']
    print(f\"  - {computer['displayName']}: {status} ({executors}/{total_executors} busy)\")
"
}

# Main monitoring loop
while true; do
    clear
    echo "Jenkins Build Monitoring Dashboard - $(date)"
    echo "============================================="
    echo
    
    get_agent_status
    echo
    get_build_queue
    echo
    get_running_builds
    echo
    echo "Press Ctrl+C to exit"
    sleep 5
done
EOF

