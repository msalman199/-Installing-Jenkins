Step 2: Common Issue Resolution
Create a troubleshooting guide script:

cat > /tmp/fix-common-issues.sh << 'EOF'
#!/bin/bash

echo "Jenkins Agent Issue Resolution"
echo "============================="

fix_ssh_issues() {
    echo "Fixing SSH connectivity issues..."
    
    # Restart SSH service
    sudo systemctl restart ssh
    
    # Fix SSH permissions
    for user in jenkins-agent1 jenkins-agent2; do
        if id "$user" &>/dev/null; then
            sudo chmod 700 /home/$user/.ssh
            sudo chmod 600 /home/$user/.ssh/*
            sudo chown -R $user:$user /home/$user/.ssh
        fi
    done
    
    # Test SSH connectivity
    echo "Testing SSH connections..."
    for user in jenkins-agent1 jenkins-agent2; do
        sudo -u jenkins ssh -o ConnectTimeout=5 -o StrictHostKeyChecking=no $user@localhost "echo 'SSH test successful for $user'" || echo "SSH still failing for $user"
    done
}

fix_jnlp_issues() {
    echo "Fixing JNLP agent issues..."
    
    # Kill existing JNLP processes
    pkill -f "agent.jar"
    
    # Restart JNLP agent
    if [ -f /opt/jenkins-agents/jnlp-agent/start-agent.sh ]; then
        echo "Restarting JNLP agent..."
        sudo -u jenkins /opt/jenkins-agents/jnlp-agent/start-agent.sh &
        sleep 5
        pgrep -f "agent.jar" && echo "JNLP agent restarted successfully" || echo "JNLP agent failed to start"
    fi
}

fix_docker_issues() {
    echo "Fixing Docker agent issues..."
    
    # Restart Docker service
    sudo systemctl restart docker
    
    # Clean up old containers
    docker container prune -f
    
    # Pull latest agent image
    docker pull jenkins/inbound-agent:latest
    
    echo "Docker issues resolved"
}

fix_permissions() {
    echo "Fixing file permissions..."
    
    # Fix Jenkins directories
    sudo chown -R jenkins:jenkins /var/lib/jenkins
    sudo chown -R jenkins:jenkins /opt/jenkins-agents/agent3
    
    # Fix agent directories
    sudo chown -R jenkins-agent1:jenkins-agent1 /opt/jenkins-agents/agent1
    sudo chown -R jenkins-agent2:jenkins-agent2 /opt/jenkins-agents/agent2
    
    echo "Permissions fixed"
}

# Main menu
echo "Select issue to fix:"
echo "1. SSH connectivity issues"
echo "2. JNLP agent issues"
echo "3. Docker agent issues"
echo "4. File permission issues"
echo "5. Fix all issues"
echo "6. Exit"

read -p "Enter choice (1-6): " choice

case $choice in
    1) fix_ssh_issues ;;
    2) fix_jnlp_issues ;;
    3) fix_docker_issues ;;
    4) fix_permissions ;;
    5) 
        fix_ssh_issues
        fix_jnlp_issues
        fix_docker_issues
        fix_permissions
        echo "All fixes applied"
        ;;
    6) echo "Exiting..." ;;
    *) echo "Invalid choice" ;;
esac
EOF

