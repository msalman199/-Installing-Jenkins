Step 2.2: Create the Retry-and-Notify Pipeline
In Jenkins, click New Item, name it failure-handling-pipeline, choose Pipeline, and click OK.
Scroll to the Pipeline section, choose Pipeline script, and enter:
pipeline {
    agent any

    environment {
        RECIPIENT_EMAIL = 'your-email@example.com'
    }

    options {
        timeout(time: 10, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        stage('Checkout') {
            steps {
                script {
                    deleteDir()
                    sh '''
                        cp -r $HOME/jenkins-failure-lab/* . 2>/dev/null || \
                        cp -r /root/jenkins-failure-lab/* . 2>/dev/null
                        ls -la
                    '''
                }
            }
        }

        stage('Build with Retry') {
            steps {
                retry(3) {
                    sh '''
                        echo "Build attempt at $(date)"
                        python3 app.py
                    '''
                }
            }
        }

        stage('Test with Backoff') {
            steps {
                script {
                    def maxRetries = 3
                    def attempt = 0
                    def success = false

                    while (attempt < maxRetries && !success) {
                        attempt++
                        try {
                            echo "Test attempt ${attempt} of ${maxRetries}"
                            sh 'python3 test.py'
                            success = true
                            echo "Tests passed on attempt ${attempt}"
                        } catch (Exception e) {
                            echo "Test attempt ${attempt} failed: ${e.getMessage()}"
                            if (attempt < maxRetries) {
                                def delay = attempt * 2
                                echo "Waiting ${delay} seconds before retry..."
                                sleep(delay)
                            } else {
                                echo "All test retries exhausted"
                                throw e
                            }
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline execution completed with result: ${currentBuild.currentResult}"
        }

        success {
            emailext(
                subject: "SUCCESS: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                body: """
                    <h2>Build Successful</h2>
                    <p>Job: ${env.JOB_NAME}, Build: ${env.BUILD_NUMBER}</p>
                    <p>URL: ${env.BUILD_URL}</p>
                """,
                mimeType: 'text/html',
                to: "${env.RECIPIENT_EMAIL}"
            )
        }

        failure {
            emailext(
                subject: "FAILURE: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
                body: """
                    <h2 style="color:red;">Build Failed</h2>
                    <p>Job: ${env.JOB_NAME}, Build: ${env.BUILD_NUMBER}</p>
                    <p>Console: ${env.BUILD_URL}console</p>
                """,
                mimeType: 'text/html',
                to: "${env.RECIPIENT_EMAIL}",
                attachLog: true
            )
        }
    }
}
Click Save.
