Step 1.3: Create the Sample Application Repository
Create a small, intentionally unreliable application that the pipeline will build, test, and deploy. This lets us safely observe failure handling without needing a real production service.

mkdir -p ~/jenkins-failure-lab
cd ~/jenkins-failure-lab
git init

cat > app.py << 'EOF'
#!/usr/bin/env python3
import sys
import random
import time

def unreliable_build():
    """Simulates a build step that fails intermittently."""
    time.sleep(1)
    if random.random() < 0.4:
        print("ERROR: Simulated build failure!")
        sys.exit(1)
    print("SUCCESS: Build completed successfully!")
    return True

if __name__ == "__main__":
    print("Starting build...")
    unreliable_build()
EOF

cat > test.py << 'EOF'
#!/usr/bin/env python3
import subprocess
import sys

def run_tests():
    """Runs the application once as a stand-in for a test suite."""
    print("Running tests...")
    result = subprocess.run([sys.executable, "app.py"], capture_output=True, text=True)
    print(result.stdout)
    if result.returncode == 0:
        print("All tests passed!")
        return True
    print("Tests failed!")
    sys.exit(1)

if __name__ == "__main__":
    run_tests()
EOF

cat > serve.py << 'EOF'
#!/usr/bin/env python3
"""Minimal HTTP server used to simulate a deployed service for health checks."""
from http.server import BaseHTTPRequestHandler, HTTPServer

class HealthHandler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path == "/health":
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            self.end_headers()
            self.wfile.write(b"OK")
        else:
            self.send_response(404)
            self.end_headers()

    def log_message(self, format, *args):
        pass  # Suppress default request logging

if __name__ == "__main__":
    server = HTTPServer(("127.0.0.1", 8099), HealthHandler)
    print("Serving health endpoint on port 8099...")
    server.serve_forever()
EOF

