Task 3: Advanced Error Handling with Helper Functions and Rollback
This task consolidates retries, structured failure handling, notifications, and a deploy-with-rollback pattern into a single pipeline using Groovy helper functions defined at the bottom of the script.

Step 3.1: Create the Advanced Pipeline
Create a new pipeline job named advanced-error-handling-pipeline.
Use the following pipeline script:
pipeline {
    agent any

    environment {
        MAX_RETRIES = '3'
        NOTIFICATION_EMAIL = 'your-email@example.com'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        skipDefaultCheckout(true)
    }

    stages {
        stage('Initialize') {
            steps {
                script {
                    env.FAILED_STAGES = ''
                    echo "Pipeline initialized"
                    sendNotification('STARTED', 'Pipeline execution started')
                }
            }
        }

        stage('Checkout') {
            steps {
                script {
                    try {
                        deleteDir()
                        sh '''
                            cp -r $HOME/jenkins-failure-lab/* . 2>/dev/null || \
                            cp -r /root/jenkins-failure-lab/* . 2>/dev/null
                            echo "Source checked out successfully"
                        '''
                    } catch (Exception e) {
                        handleStageFailure('Checkout', e.getMessage())
                        throw e
                    }
                }
            }
        }

        stage('Build') {
            steps {
                script {
                    def maxAttempts = env.MAX_RETRIES as Integer
                    def attempt = 0
                    def success = false

                    while (!success && attempt < maxAttempts) {
                        attempt++
                        try {
                            echo "Build attempt ${attempt}/${maxAttempts}"
                            sh 'python3 app.py'
                            success = true
                        } catch (Exception e) {
                            if (attempt < maxAttempts) {
                                def waitTime = attempt * 2
                                echo "Waiting ${waitTime} seconds before retry..."
                                sleep(waitTime)
                            } else {
                                handleStageFailure('Build', "Failed after ${attempt} attempts: ${e.getMessage()}")
                                throw e
                            }
                        }
                    }
                }
            }
        }

        stage('Test') {
            steps {
                script {
                    try {
                        retryWithBackoff('Test') {
                            sh 'python3 test.py'
                        }
                    } catch (Exception e) {
                        handleStageFailure('Test', e.getMessage())
                        throw e
                    }
                }
            }
        }

        stage('Deploy') {
            when {
                expression { currentBuild.result != 'FAILURE' }
            }
            steps {
                script {
                    try {
                        deployWithRollback()
                    } catch (Exception e) {
                        handleStageFailure('Deploy', e.getMessage())
                        throw e
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Pipeline completed with result: ${currentBuild.currentResult}"
                generateBuildReport()
            }
        }

        success {
            script {
                sendNotification('SUCCESS', 'Pipeline completed successfully!')
            }
        }

        failure {
            script {
                def failedStages = env.FAILED_STAGES?.trim() ?: 'Unknown'
                sendNotification('FAILURE', "Pipeline failed in stages: ${failedStages}")
            }
        }

        unstable {
            script {
                sendNotification('UNSTABLE', 'Pipeline completed with warnings')
            }
        }
    }
}

// Retries a block of steps with exponential backoff
def retryWithBackoff(stageName, closure) {
    def maxRetries = 3
    def baseDelay = 2

    for (int attempt = 1; attempt <= maxRetries; attempt++) {
        try {
            echo "${stageName}: attempt ${attempt}/${maxRetries}"
            closure()
            echo "${stageName}: succeeded on attempt ${attempt}"
            return
        } catch (Exception e) {
            if (attempt < maxRetries) {
                def delay = baseDelay * Math.pow(2, attempt - 1) as int
                echo "${stageName}: attempt ${attempt} failed, waiting ${delay} seconds..."
                sleep(delay)
            } else {
                echo "${stageName}: all retry attempts exhausted"
                throw e
            }
        }
    }
}

// Deploys the sample service and validates it with a health check, rolling back on failure
def deployWithRollback() {
    echo "Starting deployment..."

    sh '''
        echo "Stopping any previous instance..."
        pkill -f serve.py || true
        sleep 1

        echo "Starting service..."
        nohup python3 serve.py > serve.log 2>&1 &
        sleep 2
    '''

    // Health check after deployment: verify the HTTP endpoint responds correctly.
    // Retries a few times before declaring the deployment unhealthy and rolling back.
    def healthCheckPassed = false
    def healthAttempts = 3

    for (int i = 1; i <= healthAttempts; i++) {
        try {
            sh '''
                echo "Health check attempt against http://127.0.0.1:8099/health"
                response=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:8099/health)
                echo "HTTP status code: ${response}"
                if [ "${response}" != "200" ]; then
                    echo "Health check failed with status ${response}"
                    exit 1
                fi
                echo "Health check passed"
            '''
            healthCheckPassed = true
            echo "Deployment healthy on health check attempt ${i}"
            break
        } catch (Exception e) {
            echo "Health check attempt ${i} failed: ${e.getMessage()}"
            if (i < healthAttempts) {
                sleep(3)
            }
        }
    }

    if (!healthCheckPassed) {
        echo "Deployment failed health checks. Rolling back..."
        sh '''
            pkill -f serve.py || true
            echo "Rolled back: previous service instance stopped"
        '''
        error("Deployment health check failed after ${healthAttempts} attempts; rollback performed")
    }

    echo "Deployment successful and verified healthy"
}

// Records which stage failed and appends it to the FAILED_STAGES environment variable
def handleStageFailure(stageName, errorMessage) {
    echo "Stage '${stageName}' failed: ${errorMessage}"
    env.FAILED_STAGES = "${env.FAILED_STAGES ?: ''}${stageName} "
}

// Sends an email notification summarizing the current pipeline status
def sendNotification(status, message) {
    echo "Notification [${status}]: ${message}"

    def subjectPrefix = status
    def color = status == 'SUCCESS' ? 'green' : (status == 'FAILURE' ? 'red' : 'orange')

    emailext(
        subject: "${subjectPrefix}: ${env.JOB_NAME} [${env.BUILD_NUMBER}]",
        body: """
            <h2 style="color:${color};">${status}</h2>
            <p>${message}</p>
            <p>Job: ${env.JOB_NAME}, Build: ${env.BUILD_NUMBER}</p>
            <p>URL: ${env.BUILD_URL}</p>
        """,
        mimeType: 'text/html',
        to: "${env.NOTIFICATION_EMAIL}"
    )
}

// Writes a simple text build report as a build artifact
def generateBuildReport() {
    def failedStages = env.FAILED_STAGES?.trim() ?: 'None'

    sh """
        cat > build-report.txt << EOF
Build Report
============
Job: ${env.JOB_NAME}
Build Number: ${env.BUILD_NUMBER}
Result: ${currentBuild.currentResult}
Duration: ${currentBuild.durationString}
Failed Stages: ${failedStages}
EOF
        cat build-report.txt
    """

    archiveArtifacts artifacts: 'build-report.txt', allowEmptyArchive: true
}
Click Save.
