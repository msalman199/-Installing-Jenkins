Subtask 3.6: Create Advanced Pipeline with Multi-Stage Build
Create an enhanced pipeline that demonstrates more Docker features:

cd ~/jenkins-docker-lab
cat > Dockerfile.multistage << 'EOF'
# Multi-stage build for optimized production image
FROM node:18-alpine AS builder

WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production && npm cache clean --force

FROM node:18-alpine AS production

# Create non-root user
RUN addgroup -g 1001 -S nodejs && adduser -S nodejs -u 1001

WORKDIR /app

# Copy dependencies from builder stage
COPY --from=builder --chown=nodejs:nodejs /app/node_modules ./node_modules
COPY --chown=nodejs:nodejs . .

USER nodejs

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

CMD ["npm", "start"]
EOF
Create a new pipeline job called docker-multistage-pipeline with this enhanced script:

pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'your-dockerhub-username/jenkins-docker-app'
        DOCKER_TAG = "${BUILD_NUMBER}"
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    sh '''
                        cp -r /home/*/jenkins-docker-lab/* ${WORKSPACE}/
                        ls -la ${WORKSPACE}/
                    '''
                }
            }
        }
        
        stage('Build Multi-stage Image') {
            steps {
                script {
                    echo 'Building optimized Docker image with multi-stage build...'
                    sh '''
                        docker build -f Dockerfile.multistage -t ${DOCKER_IMAGE}:${DOCKER_TAG}-optimized .
                        docker build -f Dockerfile.multistage -t ${DOCKER_IMAGE}:latest-optimized .
                    '''
                }
            }
        }
        
        stage('Security Scan') {
            steps {
                script {
                    echo 'Performing basic security checks...'
                    sh '''
                        # Check for non-root user
                        docker run --rm ${DOCKER_IMAGE}:${DOCKER_TAG}-optimized whoami
                        
                        # Check image size
                        docker images ${DOCKER_IMAGE}:${DOCKER_TAG}-optimized
                    '''
                }
            }
        }
        
        stage('Performance Test') {
            steps {
                script {
                    echo 'Running performance tests...'
                    sh '''
                        # Start container
                        docker run -d --name perf-test -p 3002:3000 ${DOCKER_IMAGE}:${DOCKER_TAG}-optimized
                        
                        # Wait for startup
                        sleep 15
                        
                        # Simple load test
                        for i in {1..10}; do
                            curl -s http://localhost:3002/ > /dev/null
                            echo "Request $i completed"
                        done
                        
                        # Check container health
                        docker exec perf-test curl -f http://localhost:3000/health
                        
                        # Cleanup
                        docker stop perf-test
                        docker rm perf-test
                    '''
                }
            }
        }
        
        stage('Push Optimized Images') {
            steps {
                script {
                    echo 'Pushing optimized images to Docker Hub...'
                    sh '''
                        echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}-optimized
                        docker push ${DOCKER_IMAGE}:latest-optimized
                    '''
                }
            }
        }
    }
    
    post {
        always {
            sh 'docker logout'
        }
    }
}
