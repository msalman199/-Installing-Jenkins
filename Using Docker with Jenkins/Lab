EOF

git add .
git commit -m "Initial commit: Sample Node.js app with Dockerfile"
Task 3: Build and Push Docker Images from Jenkins Pipeline
Subtask 3.1: Create Jenkins Pipeline Job
In Jenkins web interface:

Click New Item
Enter item name: docker-build-pipeline
Select Pipeline
Click OK
Subtask 3.2: Configure Docker Hub Credentials
Before creating the pipeline, set up Docker Hub credentials:

In Jenkins, go to Manage Jenkins > Manage Credentials
Click on (global) domain
Click Add Credentials
Select Username with password
Enter your Docker Hub username and password
Set ID as dockerhub-credentials
Click OK
Subtask 3.3: Create Pipeline Script
In the pipeline configuration, scroll down to Pipeline section and enter this script:

pipeline {
    agent any
    
    environment {
        DOCKER_IMAGE = 'your-dockerhub-username/jenkins-docker-app'
        DOCKER_TAG = "${BUILD_NUMBER}"
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
    }
    
    stages {
        stage('Checkout') {
            steps {
                script {
                    // Since we're working locally, copy files to workspace
                    sh '''
                        cp -r /home/*/jenkins-docker-lab/* ${WORKSPACE}/
                        ls -la ${WORKSPACE}/
                    '''
                }
            }
        }
        
        stage('Build Docker Image') {
            steps {
                script {
                    echo 'Building Docker image...'
                    sh '''
                        docker build -t ${DOCKER_IMAGE}:${DOCKER_TAG} .
                        docker build -t ${DOCKER_IMAGE}:latest .
                    '''
                }
            }
        }
        
        stage('Test Docker Image') {
            steps {
                script {
                    echo 'Testing Docker image...'
                    sh '''
                        # Run container in background
                        docker run -d --name test-container -p 3001:3000 ${DOCKER_IMAGE}:${DOCKER_TAG}
                        
                        # Wait for container to start
                        sleep 10
                        
                        # Test the application
                        curl -f http://localhost:3001/ || exit 1
                        curl -f http://localhost:3001/health || exit 1
                        
                        # Stop and remove test container
                        docker stop test-container
                        docker rm test-container
                    '''
                }
            }
        }
        
        stage('Login to Docker Hub') {
            steps {
                script {
                    echo 'Logging in to Docker Hub...'
                    sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
                }
            }
        }
        
        stage('Push to Docker Hub') {
            steps {
                script {
                    echo 'Pushing image to Docker Hub...'
                    sh '''
                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                    '''
                }
            }
        }
        
        stage('Deploy Container') {
            steps {
                script {
                    echo 'Deploying container...'
                    sh '''
                        # Stop existing container if running
                        docker stop jenkins-app || true
                        docker rm jenkins-app || true
                        
                        # Run new container
                        docker run -d --name jenkins-app -p 3000:3000 ${DOCKER_IMAGE}:${DOCKER_TAG}
                        
                        # Verify deployment
                        sleep 5
                        curl -f http://localhost:3000/ || exit 1
                    '''
                }
            }
        }
    }
    
    post {
        always {
            script {
                echo 'Cleaning up...'
                sh '''
                    docker logout
                    # Clean up old images (keep last 3 builds)
                    docker images ${DOCKER_IMAGE} --format "table {{.Tag}}" | grep -E '^[0-9]+$' | sort -nr | tail -n +4 | xargs -I {} docker rmi ${DOCKER_IMAGE}:{} || true
                '''
            }
        }
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check logs for details.'
        }
    }
}
Important: Replace your-dockerhub-username in the pipeline script with your actual Docker Hub username.

