    agent any
    stages {
        stage('Debug') {
            steps {
                script {
                    try {
                        withCredentials([string(credentialsId: 'your-credential-id', variable: 'TEST_VAR')]) {
                            echo "Credential found and accessible"
                        }
                    } catch (Exception e) {
                        echo "Credential error: ${e.getMessage()}"
                    }
