cat > Jenkinsfile.advanced << 'EOF'
pipeline {
    agent any
    
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['development', 'staging', 'production'],
            description: 'Target deployment environment'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Skip test execution'
        )
    }
    
    environment {
        // Load credentials based on environment
        API_KEY = credentials('api-key-secret')
        DB_PASSWORD = credentials('database-password')
    }
    
    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    echo "Deployment Environment: ${params.ENVIRONMENT}"
                    echo "Skip Tests: ${params.SKIP_TESTS}"
                    
                    // Validate environment-specific requirements
                    if (params.ENVIRONMENT == 'production') {
                        echo "Production deployment requires additional validation..."
                        // In real scenarios, you might use different credentials for production
                    }
                }
            }
        }
        
        stage('Pre-deployment Tests') {
            when {
                not { params.SKIP_TESTS }
            }
            steps {
                echo 'Running pre-deployment tests...'
                withCredentials([
                    string(credentialsId: 'api-key-secret', variable: 'TEST_API_KEY'),
                    usernamePassword(credentialsId: 'service-account', 
                                   usernameVariable: 'TEST_USER', 
                                   passwordVariable: 'TEST_PASS')
                ]) {
                    script {
                        sh '''
                            echo "Testing API connectivity..."
                            if [ -n "$TEST_API_KEY" ] && [ -n "$TEST_USER" ]; then
                                echo "API test: PASSED"
                                echo "Authentication test: PASSED"
                            else
                                echo "Tests FAILED - missing credentials"
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }
        
        stage('Deploy Application') {
            steps {
                echo "Deploying to ${params.ENVIRONMENT} environment..."
                script {
                    // Use credentials in deployment script
                    sh '''
                        export API_KEY="${API_KEY}"
                        export DB_PASSWORD="${DB_PASSWORD}"
                        ./deploy.sh
                    '''
                }
            }
        }
        
        stage('Post-deployment Verification') {
            steps {
                echo 'Verifying deployment...'
                withCredentials([string(credentialsId: 'api-key-secret', variable: 'VERIFY_KEY')]) {
                    script {
                        sh '''
                            echo "Performing post-deployment checks..."
                            echo "API key verification: $(test -n "$VERIFY_KEY" && echo 'PASSED' || echo 'FAILED')"
                            echo "Deployment verification completed!"
