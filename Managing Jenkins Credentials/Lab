Subtask 3.2: Update Jenkinsfile with Credential Access
Update your local Jenkinsfile to demonstrate secure credential access:

cd ~/jenkins-lab

# Create an enhanced Jenkinsfile with credential access
cat > Jenkinsfile << 'EOF'
pipeline {
    agent any
    
    environment {
        // Define environment variables that will hold credential values
        API_KEY = credentials('api-key-secret')
        DB_PASSWORD = credentials('database-password')
    }
    
    stages {
        stage('Environment Setup') {
            steps {
                echo 'Setting up environment with secure credentials...'
                script {
                    // Verify credentials are loaded (values will be masked in logs)
                    echo "API Key loaded: ${env.API_KEY ? 'Yes' : 'No'}"
                    echo "Database password loaded: ${env.DB_PASSWORD ? 'Yes' : 'No'}"
                }
            }
        }
        
        stage('Build with Credentials') {
            steps {
                echo 'Building application with secure credentials...'
                script {
                    // Use credentials in build process
                    sh '''
                        echo "Starting build process..."
                        export API_KEY="${API_KEY}"
                        export DB_PASSWORD="${DB_PASSWORD}"
                        python3 app.py
                    '''
                }
            }
        }
        
        stage('Test with Username/Password') {
            steps {
                echo 'Testing with username/password credentials...'
                withCredentials([usernamePassword(credentialsId: 'service-account', 
                                                usernameVariable: 'SERVICE_USER', 
                                                passwordVariable: 'SERVICE_PASS')]) {
                    script {
                        sh '''
                            echo "Service User: $SERVICE_USER"
                            echo "Service Password: [MASKED]"
                            echo "Simulating service authentication..."
                            if [ "$SERVICE_USER" = "serviceuser" ]; then
                                echo "Authentication successful!"
                            else
                                echo "Authentication failed!"
                                exit 1
                            fi
                        '''
                    }
                }
            }
        }
        
        stage('SSH Key Usage Demo') {
            steps {
                echo 'Demonstrating SSH key credential usage...'
                withCredentials([sshUserPrivateKey(credentialsId: 'git-ssh-key', 
                                                 keyFileVariable: 'SSH_KEY_FILE', 
                                                 usernameVariable: 'SSH_USER')]) {
                    script {
                        sh '''
                            echo "SSH User: $SSH_USER"
                            echo "SSH Key File: $SSH_KEY_FILE"
                            echo "SSH key file exists: $(test -f $SSH_KEY_FILE && echo 'Yes' || echo 'No')"
                            echo "SSH key permissions: $(ls -la $SSH_KEY_FILE)"
                        '''
                    }
                }
            }
        }
        
        stage('Multiple Credentials Demo') {
            steps {
                echo 'Using multiple credentials in a single stage...'
                withCredentials([
                    string(credentialsId: 'api-key-secret', variable: 'API_SECRET'),
                    string(credentialsId: 'database-password', variable: 'DB_SECRET'),
                    usernamePassword(credentialsId: 'service-account', 
                                   usernameVariable: 'SVC_USER', 
                                   passwordVariable: 'SVC_PASS')
                ]) {
                    script {
                        sh '''
                            echo "=== Multiple Credentials Test ==="
                            echo "API Secret loaded: $(test -n "$API_SECRET" && echo 'Yes' || echo 'No')"
                            echo "DB Secret loaded: $(test -n "$DB_SECRET" && echo 'Yes' || echo 'No')"
                            echo "Service credentials loaded: $(test -n "$SVC_USER" && echo 'Yes' || echo 'No')"
                            echo "All credentials successfully accessed!"
                        '''
                    }
                }
            }
        }
    }
    
    post {
        always {
            echo 'Pipeline completed - credentials were handled securely'
        }
        success {
            echo 'All credential operations completed successfully!'
        }
        failure {
            echo 'Pipeline failed - check credential configuration'
        }
    }
}
EOF

