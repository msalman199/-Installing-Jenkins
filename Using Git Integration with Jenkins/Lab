Task 5: Advanced Git Integration Features
Subtask 5.1: Configure Multiple Branch Building
Go to your Jenkins job configuration
In Source Code Management > Git section
In Branches to build, change from */main to */*
This will build all branches when changes are detected
Subtask 5.2: Create and Test Feature Branch
Create a feature branch to test multi-branch building.

# Navigate to project directory
cd ~/jenkins-integration-demo

# Create and switch to feature branch
git checkout -b feature/enhanced-logging

# Add enhanced logging feature
cat > logger.js << 'EOF'
class Logger {
    static info(message) {
        console.log(`[INFO] ${new Date().toISOString()}: ${message}`);
    }
    
    static error(message) {
        console.error(`[ERROR] ${new Date().toISOString()}: ${message}`);
    }
}

module.exports = Logger;
EOF

# Update app.js to use the logger
cat > app.js << 'EOF'
const http = require('http');
const Logger = require('./logger');

const hostname = '127.0.0.1';
const port = 3000;

const server = http.createServer((req, res) => {
  Logger.info(`Received request from ${req.connection.remoteAddress}`);
  res.statusCode = 200;
  res.setHeader('Content-Type', 'text/plain');
  res.end('Hello World from Jenkins Integration Demo!\n');
});

server.listen(port, hostname, () => {
  Logger.info(`Server running at http://${hostname}:${port}/`);
});

// Added feature: current timestamp
Logger.info('Application started at: ' + new Date().toISOString());
EOF

# Commit and push feature branch
git add .
git commit -m "Add enhanced logging functionality"
git push origin feature/enhanced-logging
