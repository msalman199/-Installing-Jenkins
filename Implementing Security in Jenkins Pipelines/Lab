Subtask 5.2: Create Security Audit Script
Create a script to audit Jenkins security settings.

# Create security audit script
cat > jenkins_security_audit.sh << 'EOF'
#!/bin/bash

echo "=== Jenkins Security Audit ==="
echo "Date: $(date)"
echo

# Check Jenkins service status
echo "1. Jenkins Service Status:"
sudo systemctl status jenkins --no-pager -l
echo

# Check Jenkins process and ports
echo "2. Jenkins Process and Network:"
ps aux | grep jenkins | grep -v grep
netstat -tlnp | grep :8080
echo

# Check Jenkins configuration files permissions
echo "3. Jenkins Configuration File Permissions:"
ls -la /var/lib/jenkins/config.xml 2>/dev/null || echo "Config file not accessible"
ls -la /var/lib/jenkins/users/ 2>/dev/null || echo "Users directory not accessible"
echo

# Check for security-related plugins
echo "4. Security Plugin Check:"
if [ -d "/var/lib/jenkins/plugins" ]; then
    ls /var/lib/jenkins/plugins/ | grep -E "(role|auth|security)" || echo "No security plugins found in directory listing"
else
    echo "Plugins directory not accessible"
fi
echo

# Check Jenkins logs for security events
echo "5. Recent Security-Related Log Entries:"
sudo tail -20 /var/log/jenkins/jenkins.log 2>/dev/null | grep -i -E "(login|auth|security|role)" || echo "No recent security events found"
echo

echo "=== Audit Complete ==="
EOF

# Make script executable
chmod +x jenkins_security_audit.sh

# Run the audit
./jenkins_security_audit.sh
Subtask 5.3: Verify Pipeline Security
Test that pipelines execute with proper security context.

# Create a test script to verify pipeline execution
cat > test_pipeline_security.sh << 'EOF'
#!/bin/bash

echo "Testing Pipeline Security..."

# Function to test pipeline access
test_pipeline_access() {
    local pipeline=$1
    local token=$2
    
    echo "Testing access to $pipeline..."
    
    # Trigger build
    response=$(curl -s -w "%{http_code}" -X POST "http://localhost:8080/job/$pipeline/build?token=$token")
    http_code="${response: -3}"
    
    if [ "$http_code" = "201" ] || [ "$http_code" = "200" ]; then
        echo "✓ Successfully triggered $pipeline"
    else
        echo "✗ Failed to trigger $pipeline (HTTP: $http_code)"
    fi
}

# Test each pipeline
test_pipeline_access "development-pipeline" "dev-build-token-123"
test_pipeline_access "testing-pipeline" "test-build-token-456"
test_pipeline_access "production-pipeline" "prod-build-token-789"

echo "Pipeline security test complete."
EOF

chmod +x test_pipeline_security.sh
./test_pipeline_security.sh
