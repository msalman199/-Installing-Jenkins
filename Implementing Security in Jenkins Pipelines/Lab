Subtask 6.2: Create Security Monitoring Dashboard
Set up basic monitoring for security events.

# Create security monitoring script
cat > jenkins_security_monitor.sh << 'EOF'
#!/bin/bash

echo "=== Jenkins Security Monitor ==="
echo "Monitoring started at: $(date)"
echo

# Function to check failed login attempts
check_failed_logins() {
    echo "Checking for failed login attempts..."
    if [ -f "/var/log/jenkins/jenkins.log" ]; then
        failed_logins=$(sudo grep -c "Failed to authenticate" /var/log/jenkins/jenkins.log 2>/dev/null || echo "0")
        echo "Failed login attempts found: $failed_logins"
    else
        echo "Jenkins log file not accessible"
    fi
}

# Function to check active sessions
check_active_sessions() {
    echo "Checking Jenkins process status..."
    jenkins_pid=$(pgrep -f jenkins)
    if [ -n "$jenkins_pid" ]; then
        echo "Jenkins is running (PID: $jenkins_pid)"
        echo "Memory usage: $(ps -p $jenkins_pid -o %mem --no-headers)%"
        echo "CPU usage: $(ps -p $jenkins_pid -o %cpu --no-headers)%"
    else
        echo "Jenkins is not running!"
    fi
}

# Function to check recent builds
check_recent_builds() {
    echo "Checking for recent build activity..."
    if [ -d "/var/lib/jenkins/jobs" ]; then
        recent_builds=$(find /var/lib/jenkins/jobs -name "build.xml" -mtime -1 2>/dev/null | wc -l)
        echo "Recent builds (last 24h): $recent_builds"
    else
        echo "Jenkins jobs directory not accessible"
    fi
}

# Run monitoring checks
check_failed_logins
echo
check_active_sessions
echo
check_recent_builds
echo

echo "=== Monitoring Complete ==="
EOF

chmod +x jenkins_security_monitor.sh
./jenkins_security_monitor.sh
