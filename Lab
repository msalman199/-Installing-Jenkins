Task 3: Creating a Sample Application
Subtask 3.1: Create Project Directory and Sample Application
# Create a project directory
mkdir -p /home/jenkins-demo
cd /home/jenkins-demo

# Initialize a new Node.js project
npm init -y

# Create a simple application file
cat > app.js << 'EOF'
const http = require('http');

const server = http.createServer((req, res) => {
  res.writeHead(200, {'Content-Type': 'text/html'});
  res.end('<h1>Hello from Jenkins Pipeline!</h1>');
});

const port = process.env.PORT || 3000;
server.listen(port, () => {
  console.log(`Server running on port ${port}`);
});

